{
  "name": "elementals-editor",
  "version": "1.0.0",
  "main": "dist-electron/main.js",
  "type": "module",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && tsc -p tsconfig.electron.json",
    "preview": "vite preview",
    "electron:dev": "tsc -p tsconfig.electron.json && node dev-runner.mjs",
    "electron:build": "npm run build && electron-builder",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.electron.test.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.20",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.1",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.17",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.20",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.4",
    "@radix-ui/react-separator": "^1.1.12",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.4",
    "@radix-ui/react-tooltip": "^1.2.13",
    "@tanstack/react-router": "^1.170.18",
    "@xyflow/react": "12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dockview": "^7.0.4",
    "dockview-react": "^7.0.4",
    "konva": "^10.5.0",
    "lucide-react": "^1.25.0",
    "react-konva": "^19.2.7",
    "react-resizable-panels": "^4.12.2",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true,
    "fsevents": true
  }
}
