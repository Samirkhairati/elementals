{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Node",
    "outDir": "dist-electron",
    "rootDir": "electron",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "strict": true
  },
  "include": [
    "electron"
  ],
  "exclude": [
    "electron/**/*.test.ts",
    "electron/__testutils__"
  ]
}
